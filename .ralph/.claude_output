{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-abe947ad7111dbf7","type":"tool_result","content":"1\t/**\n2\t * Direct-to-storage upload hook.\n3\t *\n4\t * Manages the client-side upload lifecycle:\n5\t * 1. Pre-upload validation (file size + MIME type)\n6\t * 2. Request presigned PUT URL via POST /api/v1/storage/upload-intent\n7\t * 3. Direct binary PUT to S3 / R2 with progress tracking\n8\t * 4. Completion / error reporting\n9\t *\n10\t * Pre-upload validation prevents wasteful network requests by checking\n11\t * the 50 MB audio cap and allowed MIME types before contacting the API.\n12\t *\n13\t * @module lib/hooks/useDirectUpload\n14\t */\n15\t\n16\timport { useCallback, useRef, useState } from \"react\";\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// Constants\n20\t// ---------------------------------------------------------------------------\n21\t\n22\t/** Maximum allowed audio upload size in bytes (50 MB). */\n23\tconst MAX_AUDIO_FILE_SIZE = 50 * 1024 * 1024;\n24\t\n25\t/** Allowed audio MIME types. */\n26\tconst ALLOWED_AUDIO_MIME_TYPES = new Set([\"audio/mpeg\", \"audio/wav\"]);\n27\t\n28\t/** Upload-intent endpoint path. */\n29\tconst UPLOAD_INTENT_PATH = \"/api/v1/storage/upload-intent\";\n30\t\n31\t// ---------------------------------------------------------------------------\n32\t// Types\n33\t// ---------------------------------------------------------------------------\n34\t\n35\t/**\n36\t * Current upload state.\n37\t *\n38\t * | status      | payload                     | meaning                        |\n39\t * |-------------|-----------------------------|--------------------------------|\n40\t * | `idle`      | —                           | waiting for user action        |\n41\t * | `validating`| `{ file }`                  | running client-side validation |\n42\t * | `requesting`| `{ objectKey }`             | fetching presigned URL         |\n43\t * | `uploading` | `{ progress, objectKey }`   | binary transfer in progress    |\n44\t * | `completed` | `{ url, objectKey }`        | upload finished successfully   |\n45\t * | `error`     | `{ message, code }`         | failure                        |\n46\t */\n47\texport type UploadState =\n48\t  | { status: \"idle\" }\n49\t  | { status: \"validating\"; file: File }\n50\t  | { status: \"requesting\"; objectKey: string }\n51\t  | { status: \"uploading\"; progress: number; objectKey: string }\n52\t  | { status: \"completed\"; url: string; objectKey: string }\n53\t  | { status: \"error\"; message: string; code: string };\n54\t\n55\t/**\n56\t * Callback signatures for the hook.\n57\t */\n58\texport interface UseDirectUploadCallbacks {\n59\t  onProgress?: (percent: number) => void;\n60\t  onComplete?: (result: { url: string; objectKey: string }) => void;\n61\t  onError?: (message: string, code: string) => void;\n62\t}\n63\t\n64\t/**\n65\t * Validates a single file against platform upload rules.\n66\t *\n67\t * - Audio files: size ≤ 50 MB, MIME type in {audio/mpeg, audio/wav}\n68\t * - Image files: default allow (forwarded to backend for stricter checks)\n69\t *\n70\t * @param file   File to validate.\n71\t * @param type   Expected upload type (\"audio\" | \"image\").\n72\t * @returns `{ ok: true }` when valid, `{ ok: false, code, message }` otherwise.\n73\t */\n74\texport function validateFile(\n75\t  file: File,\n76\t  type: \"audio\" | \"image\",\n77\t):\n78\t  | { ok: true }\n79\t  | { ok: false; code: string; message: string } {\n80\t  const sizeOk = file.size <= MAX_AUDIO_FILE_SIZE;\n81\t\n82\t  if (type === \"audio\") {\n83\t    if (!sizeOk) {\n84\t      return {\n85\t        ok: false,\n86\t        code: \"FILE_TOO_LARGE\",\n87\t        message: `Audio files must not exceed ${MAX_AUDIO_FILE_SIZE / (1024 * 1024)} MB`,\n88\t      };\n89\t    }\n90\t    if (!ALLOWED_AUDIO_MIME_TYPES.has(file.type)) {\n91\t      return {\n92\t        ok: false,\n93\t        code: \"INVALID_AUDIO_MIME_TYPE\",\n94\t        message: `Audio uploads must be one of: ${[...ALLOWED_AUDIO_MIME_TYPES].join(\", \")}`,\n95\t      };\n96\t    }\n97\t  }\n98\t\n99\t  return { ok: true };\n100\t}\n101\t\n102\t// ---------------------------------------------------------------------------\n103\t// Hook\n104\t// ---------------------------------------------------------------------------\n105\t\n106\t/**\n107\t * React hook for direct-to-storage binary uploads.\n108\t *\n109\t * It wires up the user-facing `upload` function to the full pipeline,\n110\t * manages state via `useState`, and exposes callbacks for progress\n111\t * notification.\n112\t *\n113\t * @example\n114\t * ```tsx\n115\t * const { state, upload } = useDirectUpload();\n116\t *\n117\t * const handleFile = (file: File) =>\n118\t *   upload(file, \"artist-1\", \"track-1\");\n119\t * ```\n120\t */\n121\texport function useDirectUpload(\n122\t  callbacks: UseDirectUploadCallbacks = {},\n123\t): { state: UploadState; upload: (file: File, artistId: string) => void } {\n124\t  const [state, setState] = useState<UploadState>({ status: \"idle\" });\n125\t  const abortRef = useRef<AbortController | null>(null);\n126\t\n127\t  const { onProgress, onComplete, onError } = callbacks;\n128\t\n129\t  const upload = useCallback(\n130\t    async (file: File, artistId: string) => {\n131\t      // Abort any in-flight upload\n132\t      abortRef.current?.abort();\n133\t      abortRef.current = new AbortController();\n134\t      const { signal } = abortRef.current;\n135\t\n136\t      // --- 1. Pre-upload validation ---\n137\t      setState({ status: \"validating\", file });\n138\t\n139\t      const validation = validateFile(file, \"audio\");\n140\t      if (!validation.ok) {\n141\t        setState({ status: \"error\", message: validation.message, code: validation.code });\n142\t        onError?.(validation.message, validation.code);\n143\t        return;\n144\t      }\n145\t\n146\t      // --- 2. Request presigned URL ---\n147\t      setState((prev) =>\n148\t        prev.status === \"validating\"\n149\t          ? { status: \"requesting\", objectKey: \"\" }\n150\t          : prev,\n151\t      );\n152\t\n153\t      let intentRes: Response;\n154\t      try {\n155\t        intentRes = await fetch(UPLOAD_INTENT_PATH, {\n156\t          method: \"POST\",\n157\t          headers: { \"Content-Type\": \"application/json\" },\n158\t          body: JSON.stringify({\n159\t            fileType: \"audio\",\n160\t            fileName: file.name,\n161\t            fileSizeBytes: file.size,\n162\t            mimeType: file.type,\n163\t            artistId,\n164\t            resourceId: crypto.randomUUID(),\n165\t          }),\n166\t          signal,\n167\t        });\n168\t      } catch {\n169\t        const msg = \"Network error while requesting upload URL.\";\n170\t        setState({ status: \"error\", message: msg, code: \"NETWORK_ERROR\" });\n171\t        onError?.(msg, \"NETWORK_ERROR\");\n172\t        return;\n173\t      }\n174\t\n175\t      if (!intentRes.ok) {\n176\t        const msg = `Upload intent failed (${intentRes.status}).`;\n177\t        setState({ status: \"error\", message: msg, code: \"UPLOAD_INTENT_ERROR\" });\n178\t        onError?.(msg, \"UPLOAD_INTENT_ERROR\");\n179\t        return;\n180\t      }\n181\t\n182\t      const intentData = await intentRes.json();\n183\t      // Expecting { success: true, data: { url, objectKey } }\n184\t      const { url: uploadUrl, objectKey } =\n185\t        (intentData.data as { url: string; objectKey: string }) ?? {};\n186\t\n187\t      if (!uploadUrl) {\n188\t        const msg = \"No presigned URL returned from upload intent.\";\n189\t        setState({ status: \"error\", message: msg, code: \"NO_PRESIGNED_URL\" });\n190\t        onError?.(msg, \"NO_PRESIGNED_URL\");\n191\t        return;\n192\t      }\n193\t\n194\t      setState({ status: \"requesting\", objectKey });\n195\t\n196\t      // --- 3. Direct PUT to storage URL ---\n197\t      setState({ status: \"uploading\", progress: 0, objectKey });\n198\t\n199\t      try {\n200\t        const response = await fetch(uploadUrl, {\n201\t          method: \"PUT\",\n202\t          body: file,\n203\t          signal,\n204\t        });\n205\t\n206\t        if (!response.ok) {\n207\t          const msg = `Direct upload failed (${response.status}).`;\n208\t          setState({ status: \"error\", message: msg, code: \"UPLOAD_FAILED\" });\n209\t          onError?.(msg, \"UPLOAD_FAILED\");\n210\t          return;\n211\t        }\n212\t\n213\t        // Complete\n214\t        const result = { url: uploadUrl, objectKey };\n215\t        setState({ status: \"completed\", ...result });\n216\t        onComplete?.(result);\n217\t      } catch (err: unknown) {\n218\t        // Abort does not throw; real network errors do.\n219\t        setState({ status: \"error\", message: \"Upload was cancelled or failed.\", code: \"UPLOAD_ERROR\" });\n220\t        onError?.(\"Upload was cancelled or failed.\", \"UPLOAD_ERROR\");\n221\t      }\n222\t    },\n223\t    [onComplete, onError],\n224\t  );\n225\t\n226\t  return { state, upload };\n227\t}\n228\t"}]},"parent_tool_use_id":null,"session_id":"d72108ba-fafb-4f6f-9e75-414ab1f88a10","uuid":"c869e2f4-1533-4c25-9914-e4f91add9294","timestamp":"2026-08-06T05:26:57.751Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nitin-sharma/ralph-workspaces/e29dbeb9-bd50-43bd-b208-68007e42ec25/1f096f0a-73e7-4dbb-b1e9-ac762bb210e5/src/lib/hooks/useDirectUpload.ts","content":"/**\n * Direct-to-storage upload hook.\n *\n * Manages the client-side upload lifecycle:\n * 1. Pre-upload validation (file size + MIME type)\n * 2. Request presigned PUT URL via POST /api/v1/storage/upload-intent\n * 3. Direct binary PUT to S3 / R2 with progress tracking\n * 4. Completion / error reporting\n *\n * Pre-upload validation prevents wasteful network requests by checking\n * the 50 MB audio cap and allowed MIME types before contacting the API.\n *\n * @module lib/hooks/useDirectUpload\n */\n\nimport { useCallback, useRef, useState } from \"react\";\n\n// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\n\n/** Maximum allowed audio upload size in bytes (50 MB). */\nconst MAX_AUDIO_FILE_SIZE = 50 * 1024 * 1024;\n\n/** Allowed audio MIME types. */\nconst ALLOWED_AUDIO_MIME_TYPES = new Set([\"audio/mpeg\", \"audio/wav\"]);\n\n/** Upload-intent endpoint path. */\nconst UPLOAD_INTENT_PATH = \"/api/v1/storage/upload-intent\";\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/**\n * Current upload state.\n *\n * | status      | payload                     | meaning                        |\n * |-------------|-----------------------------|--------------------------------|\n * | `idle`      | —                           | waiting for user action        |\n * | `validating`| `{ file }`                  | running client-side validation |\n * | `requesting`| `{ objectKey }`             | fetching presigned URL         |\n * | `uploading` | `{ progress, objectKey }`   | binary transfer in progress    |\n * | `completed` | `{ url, objectKey }`        | upload finished successfully   |\n * | `error`     | `{ message, code }`         | failure                        |\n */\nexport type UploadState =\n  | { status: \"idle\" }\n  | { status: \"validating\"; file: File }\n  | { status: \"requesting\"; objectKey: string }\n  | { status: \"uploading\"; progress: number; objectKey: string }\n  | { status: \"completed\"; url: string; objectKey: string }\n  | { status: \"error\"; message: string; code: string };\n\n/**\n * Callback signatures for the hook.\n */\nexport interface UseDirectUploadCallbacks {\n  onProgress?: (percent: number) => void;\n  onComplete?: (result: { url: string; objectKey: string }) => void;\n  onError?: (message: string, code: string) => void;\n}\n\n/**\n * Validates a single file against platform upload rules.\n *\n * - Audio files: size ≤ 50 MB, MIME type in {audio/mpeg, audio/wav}\n * - Image files: default allow (forwarded to backend for stricter checks)\n *\n * @param file   File to validate.\n * @param type   Expected upload type (\"audio\" | \"image\").\n * @returns `{ ok: true }` when valid, `{ ok: false, code, message }` otherwise.\n */\nexport function validateFile(\n  file: File,\n  type: \"audio\" | \"image\",\n):\n  | { ok: true }\n  | { ok: false; code: string; message: string } {\n  const sizeOk = file.size <= MAX_AUDIO_FILE_SIZE;\n\n  if (type === \"audio\") {\n    if (!sizeOk) {\n      return {\n        ok: false,\n        code: \"FILE_TOO_LARGE\",\n        message: `Audio files must not exceed ${MAX_AUDIO_FILE_SIZE / (1024 * 1024)} MB`,\n      };\n    }\n    if (!ALLOWED_AUDIO_MIME_TYPES.has(file.type)) {\n      return {\n        ok: false,\n        code: \"INVALID_AUDIO_MIME_TYPE\",\n        message: `Audio uploads must be one of: ${[...ALLOWED_AUDIO_MIME_TYPES].join(\", \")}`,\n      };\n    }\n  }\n\n  return { ok: true };\n}\n\n// ---------------------------------------------------------------------------\n// Hook\n// ---------------------------------------------------------------------------\n\n/**\n * React hook for direct-to-storage binary uploads.\n *\n * It wires up the user-facing `upload` function to the full pipeline,\n * manages state via `useState`, and exposes callbacks for progress\n * notification.\n *\n * @example\n * ```tsx\n * const { state, upload } = useDirectUpload();\n *\n * const handleFile = (file: File) =>\n *   upload(file, \"artist-1\", \"track-1\");\n * ```\n */\nexport function useDirectUpload(\n  callbacks: UseDirectUploadCallbacks = {},\n): { state: UploadState; upload: (file: File, artistId: string) => void } {\n  const [state, setState] = useState<UploadState>({ status: \"idle\" });\n  const abortRef = useRef<AbortController | null>(null);\n\n  const { onProgress, onComplete, onError } = callbacks;\n\n  const upload = useCallback(\n    async (file: File, artistId: string) => {\n      // Abort any in-flight upload\n      abortRef.current?.abort();\n      abortRef.current = new AbortController();\n      const { signal } = abortRef.current;\n\n      // --- 1. Pre-upload validation ---\n      setState({ status: \"validating\", file });\n\n      const validation = validateFile(file, \"audio\");\n      if (!validation.ok) {\n        setState({ status: \"error\", message: validation.message, code: validation.code });\n        onError?.(validation.message, validation.code);\n        return;\n      }\n\n      // --- 2. Request presigned URL ---\n      setState((prev) =>\n        prev.status === \"validating\"\n          ? { status: \"requesting\", objectKey: \"\" }\n          : prev,\n      );\n\n      let intentRes: Response;\n      try {\n        intentRes = await fetch(UPLOAD_INTENT_PATH, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({\n            fileType: \"audio\",\n            fileName: file.name,\n            fileSizeBytes: file.size,\n            mimeType: file.type,\n            artistId,\n            resourceId: crypto.randomUUID(),\n          }),\n          signal,\n        });\n      } catch {\n        const msg = \"Network error while requesting upload URL.\";\n        setState({ status: \"error\", message: msg, code: \"NETWORK_ERROR\" });\n        onError?.(msg, \"NETWORK_ERROR\");\n        return;\n      }\n\n      if (!intentRes.ok) {\n        const msg = `Upload intent failed (${intentRes.status}).`;\n        setState({ status: \"error\", message: msg, code: \"UPLOAD_INTENT_ERROR\" });\n        onError?.(msg, \"UPLOAD_INTENT_ERROR\");\n        return;\n      }\n\n      const intentData = await intentRes.json();\n      // Expecting { success: true, data: { url, objectKey } }\n      const { url: uploadUrl, objectKey } =\n        (intentData.data as { url: string; objectKey: string }) ?? {};\n\n      if (!uploadUrl) {\n        const msg = \"No presigned URL returned from upload intent.\";\n        setState({ status: \"error\", message: msg, code: \"NO_PRESIGNED_URL\" });\n        onError?.(msg, \"NO_PRESIGNED_URL\");\n        return;\n      }\n\n      setState({ status: \"requesting\", objectKey });\n\n      // --- 3. Direct PUT to storage URL ---\n      setState({ status: \"uploading\", progress: 0, objectKey });\n\n      try {\n        const response = await fetch(uploadUrl, {\n          method: \"PUT\",\n          body: file,\n          signal,\n        });\n\n        if (!response.ok) {\n          const msg = `Direct upload failed (${response.status}).`;\n          setState({ status: \"error\", message: msg, code: \"UPLOAD_FAILED\" });\n          onError?.(msg, \"UPLOAD_FAILED\");\n          return;\n        }\n\n        // Complete\n        const result = { url: uploadUrl, objectKey };\n        setState({ status: \"completed\", ...result });\n        onComplete?.(result);\n      } catch (err: unknown) {\n        // Abort does not throw; real network errors do.\n        setState({ status: \"error\", message: \"Upload was cancelled or failed.\", code: \"UPLOAD_ERROR\" });\n        onError?.(\"Upload was cancelled or failed.\", \"UPLOAD_ERROR\");\n      }\n    },\n    [onComplete, onError],\n  );\n\n  return { state, upload };\n}\n","numLines":228,"startLine":1,"totalLines":228}}}
