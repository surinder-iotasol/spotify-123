/>\n * ```\n */\nexport function FileUploadProgress({\n  state,\n  label = \"Upload progress\",\n  className,\n}: FileUploadProgressProps): JSX.Element {\n  const liveRef = useRef<HTMLDivElement>(null);\n\n  // Announce state changes to screen readers\n  useEffect(() => {\n    if (liveRef.current) {\n      liveRef.current.textContent = `${label}: ${state.status}`;\n    }\n  }, [state.status, label]);\n\n  const percent =\n    state.status === \"uploading\" ? Math.min(100, Math.max(0, state.progress)) : 0;\n\n  return (\n    <div\n      className={cn(\n        \"flex w-full flex-col gap-2\",\n        className,\n      )}\n      aria-live=\"polite\"\n      aria-label={label}\n    >\n      {/* Hidden live region for screen readers */}\n      <div ref={liveRef} className=\"sr-only\" aria-hidden=\"false\" />\n\n      {/* Progress bar track */}\n      <div\n        className=\"relative h-3 w-full overflow-hidden rounded-full bg-muted/40\"\n        role=\"progressbar\"\n        aria-valuemin={0}\n        aria-valuemax={100}\n        aria-valuenow={state.status === \"uploading\" ? percent : undefined}\n        aria-valuetext={\n          state.status === \"uploading\" ? `${percent}%` : undefined\n        }\n      >\n        {/* Filled portion — animated via CSS transition on width */}\n        <div\n          className={cn(\n            \"h-full bg-primary transition-all duration-300\",\n            state.status === \"completed\" && \"bg-green-500\",\n            state.status === \"error\" && \"bg-red-500\",\n          )}\n          style={{ width: percent > 0 ? `${percent}%` : \"0%\" }}\n        />\n      </div>\n\n      {/* Status text */}\n      <p className=\"flex items-center justify-between text-sm\">\n        <span className=\"text-foreground\">\n          {state.status === \"idle\" && \"--\"}\n          {state.status === \"validating\" && \"Validating…\"}\n          {state.status === \"requesting\" && \"Requesting upload URL…\"}\n          {state.status === \"uploading\" && `${percent}%`}\n          {state.status === \"completed\" && \"Upload complete\"}\n          {state.status === \"error\" && \"Upload failed\"}\n        </span>\n        {state.status === \"uploading\" && (\n          <span className=\"text-muted-foreground tabular-nums\">\n            {percent}%\n          </span>\n        )}\n      </p>\n\n      {/* Error detail */}\n      {state.status === \"error\" && (\n        <div\n          className=\"rounded-md bg-red-500/10 p-2 text-xs text-red-400\"\n          role=\"alert\"\n        >\n          {state.message}\n        </div>\n      )}\n\n      {/* Success indicator */}\n      {state.status === \"completed\" && (\n        <div\n          className=\"rounded-md bg-green-500/10 p-2 text-xs text-green-400\"\n          role=\"status\"\n        >\n          File uploaded successfully.\n        </div>\n      )}\n    </div>\n  );\n}\n"}}],"model":"qwen3.6-35b","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":110532,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"d72108ba-fafb-4f6f-9e75-414ab1f88a10","uuid":"61608d21-4d8f-4c12-9a2e-36f20fd2e2f5","timestamp":"2026-08-06T05:11:06.218Z"}
