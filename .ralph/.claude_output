{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b48b8b9d33459a74","type":"tool_result","content":"1\t/**\n2\t * Unit tests for the direct-to-storage upload hook and component.\n3\t *\n4\t * Covers:\n5\t * - validateFile: size cap, MIME allowlist for audio, pass-through for image\n6\t * - useDirectUpload hook state transitions\n7\t * - FileUploadProgress component rendering in all states\n8\t * - Accessibility attributes (role, aria-*)\n9\t * - Responsive indicator behavior\n10\t *\n11\t * @module tests/unit/components/upload\n12\t */\n13\t\n14\timport { render, screen } from \"@testing-library/react\";\n15\timport { beforeEach, describe, expect, it, vi } from \"vitest\";\n16\t\n17\timport type { UploadState } from \"@/lib/hooks/useDirectUpload\";\n18\timport {\n19\t  useDirectUpload,\n20\t  validateFile,\n21\t} from \"@/lib/hooks/useDirectUpload\";\n22\timport { FileUploadProgress } from \"@/components/FileUploadProgress\";\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// validateFile tests\n26\t// ---------------------------------------------------------------------------\n27\t\n28\tdescribe(\"validateFile\", () => {\n29\t  /** Helper to create an in-memory File for testing. */\n30\t  function makeFile(\n31\t    name = \"test.mp3\",\n32\t    size = 1_000_000,\n33\t    type = \"audio/mpeg\",\n34\t  ): File {\n35\t    return new File([\"\"], name, { type, lastModified: Date.now() });\n36\t  }\n37\t\n38\t  // --- Audio: valid ---\n39\t\n40\t  it(\"accepts valid audio (within size, correct MIME)\", () => {\n41\t    const result = validateFile(makeFile(\"song.mp3\", 5_000_000, \"audio/mpeg\"), \"audio\");\n42\t    expect(result).toEqual({ ok: true });\n43\t  });\n44\t\n45\t  it(\"accepts WAV audio\", () => {\n46\t    const result = validateFile(makeFile(\"song.wav\", 3_000_000, \"audio/wav\"), \"audio\");\n47\t    expect(result).toEqual({ ok: true });\n48\t  });\n49\t\n50\t  // --- Audio: size too large ---\n51\t\n52\t  it(\"rejects audio exceeding 50 MB\", () => {\n53\t    const file = makeFile(\"big.mp3\", 55 * 1024 * 1024, \"audio/mpeg\");\n54\t    const result = validateFile(file, \"audio\");\n55\t    expect(result).toEqual({\n56\t      ok: false,\n57\t      code: \"FILE_TOO_LARGE\",\n58\t      message: expect.stringContaining(\"50 MB\"),\n59\t    });\n60\t  });\n61\t\n62\t  // --- Audio: wrong MIME ---\n63\t\n64\t  it(\"rejects audio with disallowed MIME type\", () => {\n65\t    const file = makeFile(\"song.flac\", 4_000_000, \"audio/flac\");\n66\t    const result = validateFile(file, \"audio\");\n67\t    expect(result).toEqual({\n68\t      ok: false,\n69\t      code: \"INVALID_AUDIO_MIME_TYPE\",\n70\t      message: expect.stringContaining(\"audio/mpeg\"),\n71\t    });\n72\t  });\n73\t\n74\t  // --- Image: pass-through ---\n75\t\n76\t  it(\"accepts image regardless of size (backend enforces limit)\", () => {\n77\t    const file = makeFile(\"photo.jpg\", 20 * 1024 * 1024, \"image/jpeg\");\n78\t    const result = validateFile(file, \"image\");\n79\t    expect(result).toEqual({ ok: true });\n80\t  });\n81\t\n82\t  // --- Edge: zero-size file ---\n83\t\n84\t  it(\"accepts zero-byte file\", () => {\n85\t    const file = makeFile(\"empty.mp3\", 0, \"audio/mpeg\");\n86\t    const result = validateFile(file, \"audio\");\n87\t    expect(result).toEqual({ ok: true });\n88\t  });\n89\t\n90\t  // --- Edge: exact max size ---\n91\t\n92\t  it(\"accepts audio exactly at 50 MB limit\", () => {\n93\t    const file = makeFile(\"max.mp3\", 50 * 1024 * 1024, \"audio/mpeg\");\n94\t    const result = validateFile(file, \"audio\");\n95\t    expect(result).toEqual({ ok: true });\n96\t  });\n97\t});\n98\t\n99\t// ---------------------------------------------------------------------------\n100\t// useDirectUpload hook — state transitions\n101\t// ---------------------------------------------------------------------------\n102\t\n103\tdescribe(\"useDirectUpload\", () => {\n104\t  beforeEach(() => {\n105\t    vi.restoreAllMocks();\n106\t    vi.clearAllMocks();\n107\t    // Mock fetch globally\n108\t    vi.spyOn(globalThis, \"fetch\").mockResolvedValue({\n109\t      ok: true,\n110\t      status: 200,\n111\t      json: async () => ({\n112\t        success: true,\n113\t        data: { url: \"https://mock.s3/upload-url\", objectKey: \"audio/artist-1/track-1.mp3\" },\n114\t      }),\n115\t      headers: new Headers(),\n116\t    } as Response);\n117\t    // Mock crypto.randomUUID\n118\t    vi.spyOn(globalThis.crypto, \"randomUUID\").mockReturnValue(\"mock-uuid-123\");\n119\t  });\n120\t\n121\t  it(\"starts in idle state\", () => {\n122\t    const { wrapper } = renderHook();\n123\t    const { result } = wrapper(() => useDirectUpload());\n124\t    expect(result.current.state.status).toBe(\"idle\");\n125\t  });\n126\t\n127\t  it(\"transitions to error on validation rejection\", async () => {\n128\t    const bigFile = new File([\"x\".repeat(55 * 1024 * 1024)], \"big.mp3\", {\n129\t      type: \"audio/mpeg\",\n130\t      lastModified: Date.now(),\n131\t    });\n132\t    const { wrapper } = renderHook();\n133\t    const { result, waitForState } = wrapper(() => {\n134\t      const { state, upload } = useDirectUpload();\n135\t      return { state, upload };\n136\t    });\n137\t    const { upload } = result.current;\n138\t    upload(bigFile, \"artist-1\");\n139\t    await waitForState((s) => s.state.status === \"error\");\n140\t    expect(result.current.state.status).toBe(\"error\");\n141\t    expect(result.current.state.code).toBe(\"FILE_TOO_LARGE\");\n142\t  });\n143\t\n144\t  it(\"transitions through states on successful upload\", async () => {\n145\t    const mockFetch = vi.fn();\n146\t    mockFetch.mockImplementation((url: string, init: RequestInit) => {\n147\t      if (url.includes(\"/api/v1/storage/upload-intent\") || url.includes(\"upload-intent\")) {\n148\t        // Presigned URL request\n149\t        return Promise.resolve({\n150\t      