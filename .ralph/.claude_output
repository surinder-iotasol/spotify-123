{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a15e56cd1c8e2303","type":"tool_result","content":"1\t/**\n2\t * Unit tests for the direct-to-storage upload hook and progress component.\n3\t *\n4\t * @module tests/unit/components/upload\n5\t */\n6\t\n7\timport React from \"react\";\n8\t\n9\timport { beforeEach, describe, expect, it, vi, afterEach } from \"vitest\";\n10\t\n11\timport { cleanup, render, screen } from \"@testing-library/react\";\n12\t\n13\timport { FileUploadProgress } from \"@/components/FileUploadProgress\";\n14\timport { useDirectUpload, validateFile } from \"@/lib/hooks/useDirectUpload\";\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// Helpers\n18\t// ---------------------------------------------------------------------------\n19\t\n20\tfunction makeFile(name = \"test.mp3\", type = \"audio/mpeg\", size = 1_000_000): File {\n21\t  return new File([new ArrayBuffer(size)], name, { type });\n22\t}\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// beforeEach / afterEach\n26\t// ---------------------------------------------------------------------------\n27\t\n28\tafterEach(cleanup);\n29\t\n30\tbeforeEach(() => {\n31\t  vi.restoreAllMocks();\n32\t});\n33\t\n34\t/** Set up a default fetch mock that resolves to a success response. */\n35\tfunction setupDefaultFetchMock(overrides?: { status?: number; data?: Record<string, unknown> }) {\n36\t  vi.spyOn(globalThis, \"fetch\").mockImplementation(async () => {\n37\t    // Return a fresh Response each call (no shared mutable state)\n38\t    return new Response(\n39\t      JSON.stringify({\n40\t        success: true,\n41\t        data: { url: \"http://default.url\", objectKey: \"default\", ...overrides?.data },\n42\t      }),\n43\t      { status: overrides?.status ?? 200 },\n44\t    );\n45\t  });\n46\t}\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// validateFile  — unit tests\n50\t// ---------------------------------------------------------------------------\n51\t\n52\tdescribe(\"validateFile\", () => {\n53\t  it(\"accepts a valid MP3 file\", () => {\n54\t    expect(validateFile(makeFile(\"song.mp3\", \"audio/mpeg\", 10_000_000), \"audio\").ok).toBe(true);\n55\t  });\n56\t\n57\t  it(\"accepts a valid WAV file\", () => {\n58\t    expect(validateFile(makeFile(\"track.wav\", \"audio/wav\", 5_000_000), \"audio\").ok).toBe(true);\n59\t  });\n60\t\n61\t  it(\"rejects an audio file that exceeds 50 MB\", () => {\n62\t    const res = validateFile(makeFile(\"huge.mp3\", \"audio/mpeg\", 55 * 1024 * 1024), \"audio\");\n63\t    expect(res.ok).toBe(false);\n64\t    expect(res.code).toBe(\"FILE_TOO_LARGE\");\n65\t  });\n66\t\n67\t  it(\"rejects an invalid audio MIME type\", () => {\n68\t    const res = validateFile(makeFile(\"bad.opus\", \"audio/opus\", 1_000_000), \"audio\");\n69\t    expect(res.ok).toBe(false);\n70\t    expect(res.code).toBe(\"INVALID_AUDIO_MIME_TYPE\");\n71\t  });\n72\t\n73\t  it(\"passes image files through without strict checks\", () => {\n74\t    expect(validateFile(makeFile(\"photo.jpg\", \"image/jpeg\", 2_000_000), \"image\").ok).toBe(true);\n75\t  });\n76\t\n77\t  it(\"passes image files > 50 MB through (backend enforces)\", () => {\n78\t    expect(validateFile(makeFile(\"big.png\", \"image/png\", 60 * 1024 * 1024), \"image\").ok).toBe(true);\n79\t  });\n80\t\n81\t  it(\"accepts any MIME valid for audio\", () => {\n82\t    expect(validateFile(makeFile(\"t.wav\", \"audio/wav\", 100_000), \"audio\").ok).toBe(true);\n83\t  });\n84\t});\n85\t\n86\t// ---------------------------------------------------------------------------\n87\t// useDirectUpload  — unit tests\n88\t// ---------------------------------------------------------------------------\n89\t\n90\tdescribe(\"useDirectUpload\", () => {\n91\t  function renderHook(cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() }) {\n92\t    let captured: ReturnType<typeof useDirectUpload> | undefined;\n93\t    function TestWrapper() {\n94\t      captured = useDirectUpload(cb);\n95\t      return null;\n96\t    }\n97\t    render(<TestWrapper />);\n98\t    return { hook: captured as ReturnType<typeof useDirectUpload>, cb };\n99\t  }\n100\t\n101\t  it(\"starts in idle state\", () => {\n102\t    const { hook } = renderHook();\n103\t    expect(hook.state.status).toBe(\"idle\");\n104\t  });\n105\t\n106\t  it(\"transitions: idle -> error on validation failure\", async () => {\n107\t    const { hook, cb } = renderHook();\n108\t    const big = makeFile(\"huge.mp3\", \"audio/mpeg\", 55 * 1024 * 1024);\n109\t\n110\t    await hook.upload(big, \"artist-1\");\n111\t\n112\t    expect(hook.state.status).toBe(\"error\");\n113\t    if (hook.state.status === \"error\") {\n114\t      expect(hook.state.code).toBe(\"FILE_TOO_LARGE\");\n115\t    }\n116\t    expect(cb.onError).toHaveBeenCalledWith(\n117\t      \"FILE_TOO_LARGE\",\n118\t      \"FILE_TOO_LARGE\",\n119\t    );\n120\t  });\n121\t\n122\t  it(\"transitions: idle -> requesting -> completed\", async () => {\n123\t    const cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() };\n124\t\n125\t    // Create a unique URL so we can verify it was returned\n126\t    const successUrl = \"http://presigned-unique-abc.url\";\n127\t    setupDefaultFetchMock({ data: { url: successUrl, objectKey: \"audio/1/abc.mp3\" } });\n128\t\n129\t    const { hook } = renderHook(cb);\n130\t    const file = makeFile(\"demo.mp3\", \"audio/mpeg\", 1_000_000);\n131\t\n132\t    await hook.upload(file, \"artist-1\");\n133\t\n134\t    expect(hook.state.status).toBe(\"completed\");\n135\t    if (hook.state.status === \"completed\") {\n136\t      expect(hook.state.url).toBe(successUrl);\n137\t    }\n138\t    expect(cb.onComplete).toHaveBeenCalledWith(\n139\t      expect.objectContaining({ url: successUrl }),\n140\t    );\n141\t  });\n142\t\n143\t  it(\"reports error on 500 from upload-intent\", async () => {\n144\t    const cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() };\n145\t\n146\t    setupDefaultFetchMock({ status: 500 });\n147\t\n148\t    const { hook } = renderHook(cb);\n149\t    const file = makeFile(\"ok.mp3\", \"audio/mpeg\", 1_000_000);\n150\t\n151\t    await hook.upload(file, \"artist-1\");\n152\t\n153\t    if (hook.state.status === \"error\") {\n154\t      expect(hook.state.code).toBe(\"NETWORK_ERROR\");\n155\t    }\n156\t  });\n157\t\n158\t  it(\"reports error on network failure\", async () => {\n159\t    const cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() };\n160\t\n161\t    // Override the beforeEach default with a reject\n162\t    vi.restoreAllMocks();\n163\t    vi.spyOn(globalThis, \"fetch\").mockRejectedValue(new Error(\"ECONNREFUSED\"));\n164\t\n165\t    const { hook } = renderHook(cb);\n166\t    const file = makeFile(\"ok.mp3\", \"audio/mpeg\", 1_000_000);\n167\t\n168\t    await hook.upload(file, \"artist-1\");\n169\t\n170\t    if (hook.state.status === \"error\") {\n171\t      expect(hook.state.code).toBe(\"NETWORK_ERROR\");\n172\t    }\n173\t  });\n174\t\n175\t  it(\"aborts previous upload on new call\", () => {\n176\t    const cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() };\n177\t\n178\t    // Create a spy that tracks call count\n179\t    let callCount = 0;\n180\t    const neverResolve = vi.fn(async () => { callCount++; await new Promise(() => {}); });\n181\t    vi.spyOn(globalThis, \"fetch\").mockImplementation(neverResolve);\n182\t\n183\t    const { hook } = renderHook(cb);\n184\t    const file1 = makeFile(\"first.mp3\", \"audio/mpeg\", 1_000_000);\n185\t\n186\t    void hook.upload(file1, \"artist-1\");\n187\t    void hook.upload(makeFile(\"second.mp3\", \"audio/mpeg\", 500_000), \"artist-2\");\n188\t\n189\t    // After two rapid calls, fetch should have been called at least twice\n190\t    expect(neverResolve).toHaveBeenCalledTimes(2);\n191\t  });\n192\t});\n193\t\n194\t// ---------------------------------------------------------------------------\n195\t// FileUploadProgress  — component tests\n196\t// ---------------------------------------------------------------------------\n197\t\n198\tdescribe(\"FileUploadProgress\", () => {\n199\t  afterEach(cleanup);\n200\t\n201\t  it(\"renders idle state with progressbar\", () => {\n202\t    render(<FileUploadProgress state={{ status: \"idle\" }} />);\n203\t    expect(screen.getByRole(\"progressbar\")).toBeDefined();\n204\t  });\n205\t\n206\t  it(\"renders percentage in uploading state\", () => {\n207\t    render(\n208\t      <FileUploadProgress state={{ status: \"uploading\", progress: 65, objectKey: \"x\" }} />\n209\t    );\n210\t    expect(screen.getByText(\"65%\")).toBeDefined();\n211\t  });\n212\t\n213\t  it(\"renders completed state with success message\", () => {\n214\t    render(\n215\t      <FileUploadProgress state={{ status: \"completed\", url: \"http://x\", objectKey: \"y\" }} />\n216\t    );\n217\t    expect(screen.getByText(\"Upload complete\")).toBeDefined();\n218\t    expect(screen.getByText(\"File uploaded successfully.\")).toBeDefined();\n219\t  });\n220\t\n221\t  it(\"renders error with alert role and message\", () => {\n222\t    render(\n223\t      <FileUploadProgress state={{ status: \"error\", message: \"Upload failed\", code: \"UPLOAD_FAILED\" }} />\n224\t    );\n225\t    expect(screen.getByRole(\"alert\")).toHaveTextContent(\"Upload failed\");\n226\t  });\n227\t\n228\t  it(\"exposes aria-valuenow during upload\", () => {\n229\t    render(\n230\t      <FileUploadProgress state={{ status: \"uploading\", progress: 40, objectKey: \"k\" }} />\n231\t    );\n232\t    const bar = screen.getByRole(\"progressbar\");\n233\t    expect(bar).toHaveAttribute(\"aria-valuenow\", \"40\");\n234\t    expect(bar).toHaveAttribute(\"aria-valuetext\", \"40%\");\n235\t  });\n236\t\n237\t  it(\"accepts custom label prop\", () => {\n238\t    render(<FileUploadProgress state={{ status: \"idle\" }} label=\"Drag & drop\" />);\n239\t    expect(document.querySelector(\"[aria-label='Drag & drop']\")).not.toBeNull();\n240\t  });\n241\t});\n242\t"}]},"parent_tool_use_id":null,"session_id":"d72108ba-fafb-4f6f-9e75-414ab1f88a10","uuid":"edebf45a-c478-4ff5-b666-72bb6b94f5fd","timestamp":"2026-08-06T06:43:38.978Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nitin-sharma/ralph-workspaces/e29dbeb9-bd50-43bd-b208-68007e42ec25/1f096f0a-73e7-4dbb-b1e9-ac762bb210e5/tests/unit/components/upload.test.tsx","content":"/**\n * Unit tests for the direct-to-storage upload hook and progress component.\n *\n * @module tests/unit/components/upload\n */\n\nimport React from \"react\";\n\nimport { beforeEach, describe, expect, it, vi, afterEach } from \"vitest\";\n\nimport { cleanup, render, screen } from \"@testing-library/react\";\n\nimport { FileUploadProgress } from \"@/components/FileUploadProgress\";\nimport { useDirectUpload, validateFile } from \"@/lib/hooks/useDirectUpload\";\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction makeFile(name = \"test.mp3\", type = \"audio/mpeg\", size = 1_000_000): File {\n  return new File([new ArrayBuffer(size)], name, { type });\n}\n\n// ---------------------------------------------------------------------------\n// beforeEach / afterEach\n// ---------------------------------------------------------------------------\n\nafterEach(cleanup);\n\nbeforeEach(() => {\n  vi.restoreAllMocks();\n});\n\n/** Set up a default fetch mock that resolves to a success response. */\nfunction setupDefaultFetchMock(overrides?: { status?: number; data?: Record<string, unknown> }) {\n  vi.spyOn(globalThis, \"fetch\").mockImplementation(async () => {\n    // Return a fresh Response each call (no shared mutable state)\n    return new Response(\n      JSON.stringify({\n        success: true,\n        data: { url: \"http://default.url\", objectKey: \"default\", ...overrides?.data },\n      }),\n      { status: overrides?.status ?? 200 },\n    );\n  });\n}\n\n// ---------------------------------------------------------------------------\n// validateFile  — unit tests\n// ---------------------------------------------------------------------------\n\ndescribe(\"validateFile\", () => {\n  it(\"accepts a valid MP3 file\", () => {\n    expect(validateFile(makeFile(\"song.mp3\", \"audio/mpeg\", 10_000_000), \"audio\").ok).toBe(true);\n  });\n\n  it(\"accepts a valid WAV file\", () => {\n    expect(validateFile(makeFile(\"track.wav\", \"audio/wav\", 5_000_000), \"audio\").ok).toBe(true);\n  });\n\n  it(\"rejects an audio file that exceeds 50 MB\", () => {\n    const res = validateFile(makeFile(\"huge.mp3\", \"audio/mpeg\", 55 * 1024 * 1024), \"audio\");\n    expect(res.ok).toBe(false);\n    expect(res.code).toBe(\"FILE_TOO_LARGE\");\n  });\n\n  it(\"rejects an invalid audio MIME type\", () => {\n    const res = validateFile(makeFile(\"bad.opus\", \"audio/opus\", 1_000_000), \"audio\");\n    expect(res.ok).toBe(false);\n    expect(res.code).toBe(\"INVALID_AUDIO_MIME_TYPE\");\n  });\n\n  it(\"passes image files through without strict checks\", () => {\n    expect(validateFile(makeFile(\"photo.jpg\", \"image/jpeg\", 2_000_000), \"image\").ok).toBe(true);\n  });\n\n  it(\"passes image files > 50 MB through (backend enforces)\", () => {\n    expect(validateFile(makeFile(\"big.png\", \"image/png\", 60 * 1024 * 1024), \"image\").ok).toBe(true);\n  });\n\n  it(\"accepts any MIME valid for audio\", () => {\n    expect(validateFile(makeFile(\"t.wav\", \"audio/wav\", 100_000), \"audio\").ok).toBe(true);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// useDirectUpload  — unit tests\n// ---------------------------------------------------------------------------\n\ndescribe(\"useDirectUpload\", () => {\n  function renderHook(cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() }) {\n    let captured: ReturnType<typeof useDirectUpload> | undefined;\n    function TestWrapper() {\n      captured = useDirectUpload(cb);\n      return null;\n    }\n    render(<TestWrapper />);\n    return { hook: captured as ReturnType<typeof useDirectUpload>, cb };\n  }\n\n  it(\"starts in idle state\", () => {\n    const { hook } = renderHook();\n    expect(hook.state.status).toBe(\"idle\");\n  });\n\n  it(\"transitions: idle -> error on validation failure\", async () => {\n    const { hook, cb } = renderHook();\n    const big = makeFile(\"huge.mp3\", \"audio/mpeg\", 55 * 1024 * 1024);\n\n    await hook.upload(big, \"artist-1\");\n\n    expect(hook.state.status).toBe(\"error\");\n    if (hook.state.status === \"error\") {\n      expect(hook.state.code).toBe(\"FILE_TOO_LARGE\");\n    }\n    expect(cb.onError).toHaveBeenCalledWith(\n      \"FILE_TOO_LARGE\",\n      \"FILE_TOO_LARGE\",\n    );\n  });\n\n  it(\"transitions: idle -> requesting -> completed\", async () => {\n    const cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() };\n\n    // Create a unique URL so we can verify it was returned\n    const successUrl = \"http://presigned-unique-abc.url\";\n    setupDefaultFetchMock({ data: { url: successUrl, objectKey: \"audio/1/abc.mp3\" } });\n\n    const { hook } = renderHook(cb);\n    const file = makeFile(\"demo.mp3\", \"audio/mpeg\", 1_000_000);\n\n    await hook.upload(file, \"artist-1\");\n\n    expect(hook.state.status).toBe(\"completed\");\n    if (hook.state.status === \"completed\") {\n      expect(hook.state.url).toBe(successUrl);\n    }\n    expect(cb.onComplete).toHaveBeenCalledWith(\n      expect.objectContaining({ url: successUrl }),\n    );\n  });\n\n  it(\"reports error on 500 from upload-intent\", async () => {\n    const cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() };\n\n    setupDefaultFetchMock({ status: 500 });\n\n    const { hook } = renderHook(cb);\n    const file = makeFile(\"ok.mp3\", \"audio/mpeg\", 1_000_000);\n\n    await hook.upload(file, \"artist-1\");\n\n    if (hook.state.status === \"error\") {\n      expect(hook.state.code).toBe(\"NETWORK_ERROR\");\n    }\n  });\n\n  it(\"reports error on network failure\", async () => {\n    const cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() };\n\n    // Override the beforeEach default with a reject\n    vi.restoreAllMocks();\n    vi.spyOn(globalThis, \"fetch\").mockRejectedValue(new Error(\"ECONNREFUSED\"));\n\n    const { hook } = renderHook(cb);\n    const file = makeFile(\"ok.mp3\", \"audio/mpeg\", 1_000_000);\n\n    await hook.upload(file, \"artist-1\");\n\n    if (hook.state.status === \"error\") {\n      expect(hook.state.code).toBe(\"NETWORK_ERROR\");\n    }\n  });\n\n  it(\"aborts previous upload on new call\", () => {\n    const cb = { onProgress: vi.fn(), onComplete: vi.fn(), onError: vi.fn() };\n\n    // Create a spy that tracks call count\n    let callCount = 0;\n    const neverResolve = vi.fn(async () => { callCount++; await new Promise(() => {}); });\n    vi.spyOn(globalThis, \"fetch\").mockImplementation(neverResolve);\n\n    const { hook } = renderHook(cb);\n    const file1 = makeFile(\"first.mp3\", \"audio/mpeg\", 1_000_000);\n\n    void hook.upload(file1, \"artist-1\");\n    void hook.upload(makeFile(\"second.mp3\", \"audio/mpeg\", 500_000), \"artist-2\");\n\n    // After two rapid calls, fetch should have been called at least twice\n    expect(neverResolve).toHaveBeenCalledTimes(2);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// FileUploadProgress  — component tests\n// ---------------------------------------------------------------------------\n\ndescribe(\"FileUploadProgress\", () => {\n  afterEach(cleanup);\n\n  it(\"renders idle state with progressbar\", () => {\n    render(<FileUploadProgress state={{ status: \"idle\" }} />);\n    expect(screen.getByRole(\"progressbar\")).toBeDefined();\n  });\n\n  it(\"renders percentage in uploading state\", () => {\n    render(\n      <FileUploadProgress state={{ status: \"uploading\", progress: 65, objectKey: \"x\" }} />\n    );\n    expect(screen.getByText(\"65%\")).toBeDefined();\n  });\n\n  it(\"renders completed state with success message\", () => {\n    render(\n      <FileUploadProgress state={{ status: \"completed\", url: \"http://x\", objectKey: \"y\" }} />\n    );\n    expect(screen.getByText(\"Upload complete\")).toBeDefined();\n    expect(screen.getByText(\"File uploaded successfully.\")).toBeDefined();\n  });\n\n  it(\"renders error with alert role and message\", () => {\n    render(\n      <FileUploadProgress state={{ status: \"error\", message: \"Upload failed\", code: \"UPLOAD_FAILED\" }} />\n    );\n    expect(screen.getByRole(\"alert\")).toHaveTextContent(\"Upload failed\");\n  });\n\n  it(\"exposes aria-valuenow during upload\", () => {\n    render(\n      <FileUploadProgress state={{ status: \"uploading\", progress: 40, objectKey: \"k\" }} />\n    );\n    const bar = screen.getByRole(\"progressbar\");\n    expect(bar).toHaveAttribute(\"aria-valuenow\", \"40\");\n    expect(bar).toHaveAttribute(\"aria-valuetext\", \"40%\");\n  });\n\n  it(\"accepts custom label prop\", () => {\n    render(<FileUploadProgress state={{ status: \"idle\" }} label=\"Drag & drop\" />);\n    expect(document.querySelector(\"[aria-label='Drag & drop']\")).not.toBeNull();\n  });\n});\n","numLines":242,"startLine":1,"totalLines":242}}}
