"FILE_TOO_LARGE\",\n        message: `Audio files must not exceed ${MAX_AUDIO_FILE_SIZE / (1024 * 1024)} MB`,\n      };\n    }\n    if (!ALLOWED_AUDIO_MIME_TYPES.has(file.type)) {\n      return {\n        ok: false,\n        code: \"INVALID_AUDIO_MIME_TYPE\",\n        message: `Audio uploads must be one of: ${[...ALLOWED_AUDIO_MIME_TYPES].join(\", \")}`,\n      };\n    }\n  }\n\n  return { ok: true };\n}\n\n// ---------------------------------------------------------------------------\n// Hook\n// ---------------------------------------------------------------------------\n\n/**\n * React hook for direct-to-storage binary uploads.\n *\n * It wires up the user-facing `upload` function to the full pipeline,\n * manages state via `useState`, and exposes callbacks for progress\n * notification.\n *\n * @example\n * ```tsx\n * const { state, upload } = useDirectUpload();\n *\n * const handleFile = (file: File) =>\n *   upload(file, \"artist-1\", \"track-1\");\n * ```\n */\nexport function useDirectUpload(\n  callbacks: UseDirectUploadCallbacks = {},\n): { state: UploadState; upload: (file: File, artistId: string) => void } {\n  const [state, setState] = useState<UploadState>({ status: \"idle\" });\n  const abortRef = useRef<AbortController | null>(null);\n\n  const { onProgress, onComplete, onError } = callbacks;\n\n  const upload = useCallback(\n    async (file: File, artistId: string) => {\n      // Abort any in-flight upload\n      abortRef.current?.abort();\n      abortRef.current = new AbortController();\n      const { signal } = abortRef.current;\n\n      // --- 1. Pre-upload validation ---\n      setState({ status: \"validating\", file });\n\n      const validation = validateFile(file, \"audio\");\n      if (!validation.ok) {\n        setState({ status: \"error\", message: validation.message, code: validation.code });\n        onError?.(validation.message, validation.code);\n        return;\n      }\n\n      // --- 2. Request presigned URL ---\n      setState((prev) =>\n        prev.status === \"validating\"\n          ? { status: \"requesting\", objectKey: \"\" }\n          : prev,\n      );\n\n      let intentRes: Response;\n      try {\n        intentRes = await fetch(UPLOAD_INTENT_PATH, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({\n            fileType: \"audio\",\n            fileName: file.name,\n            fileSizeBytes: file.size,\n            mimeType: file.type,\n            artistId,\n            resourceId: crypto.randomUUID(),\n          }),\n          signal,\n        });\n      } catch {\n        const msg = \"Network error while requesting upload URL.\";\n        setState({ status: \"error\", message: msg, code: \"NETWORK_ERROR\" });\n        onError?.(msg, \"NETWORK_ERROR\");\n        return;\n      }\n\n      if (!intentRes.ok) {\n        const msg = `Upload intent failed (${intentRes.status}).`;\n        setState({ status: \"error\", message: msg, code: \"UPLOAD_INTENT_ERROR\" });\n        onError?.(msg, \"UPLOAD_INTENT_ERROR\");\n        return;\n      }\n\n      const intentData = await intentRes.json();\n      // Expecting { success: true, data: { url, objectKey } }\n      const { url: uploadUrl, objectKey } =\n        (intentData.data as { url: string; objectKey: string }) ?? {};\n\n      if (!uploadUrl) {\n        const msg = \"No presigned URL returned from upload intent.\";\n        setState({ status: \"error\", message: msg, code: \"NO_PRESIGNED_URL\" });\n        onError?.(msg, \"NO_PRESIGNED_URL\");\n        return;\n      }\n\n      setState({ status: \"requesting\", objectKey });\n\n      // --- 3. Direct PUT to storage URL ---\n      setState({ status: \"uploading\", progress: 0, objectKey });\n\n      try {\n        const response = await fetch(uploadUrl, {\n          method: \"PUT\",\n          body: file,\n          signal,\n        });\n\n        if (!response.ok) {\n          const msg = `Direct upload failed (${response.status}).`;\n          setState({ status: \"error\", message: msg, code: \"UPLOAD_FAILED\" });\n          onError?.(msg, \"UPLOAD_FAILED\");\n          return;\n        }\n\n        // Complete\n        const result = { url: uploadUrl, objectKey };\n        setState({ status: \"completed\", ...result });\n        onComplete?.(result);\n      } catch (err: unknown) {\n        // Abort does not throw; real network errors do.\n        setState({ status: \"error\", message: \"Upload was cancelled or failed.\", code: \"UPLOAD_ERROR\" });\n        onError?.(\"Upload was cancelled or failed.\", \"UPLOAD_ERROR\");\n      }\n    },\n    [onComplete, onError],\n  );\n\n  return { state, upload };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
