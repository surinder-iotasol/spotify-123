 it(\"progress bar wrapper uses fluid width for responsiveness\", () => {\n    const { container } = render(\n      <FileUploadProgress state={{ status: \"uploading\", progress: 20, objectKey: \"\" }} />,\n    );\n    const bar = container.querySelector<any>(\"[role='progressbar']\");\n    expect(bar).toHaveClass(\"w-full\");\n  });\n\n  it(\"outer wrapper stacks children vertically\", () => {\n    const { container } = render(<FileUploadProgress state={{ status: \"idle\" }} />);\n    expect(container.firstChild).toHaveClass(\"flex-col\");\n  });\n\n  it(\"displays zero percent for uploading at start\", () => {\n    render(<FileUploadProgress state={{ status: \"uploading\", progress: 0, objectKey: \"\" }} />);\n    expect(screen.getByText(\"0%\")).toBeInTheDocument();\n  });\n});\n\n// ---------------------------------------------------------------------------\n// validateFile — additional edge cases\n// ---------------------------------------------------------------------------\n\ndescribe(\"validateFile — edge cases\", () => {\n  it(\"accepts exactly 50 MB\", () => {\n    const f = makeFile(\"exact.mp3\", \"audio/mpeg\", 50 * 1024 * 1024);\n    expect(validateFile(f, \"audio\").ok).toBe(true);\n  });\n\n  it(\"rejects 50 MB + 1 byte\", () => {\n    const f = makeFile(\"overflow.mp3\", \"audio/mpeg\", 50 * 1024 * 1024 + 1);\n    const result = validateFile(f, \"audio\");\n    expect(result.ok).toBe(false);\n    if (!result.ok) expect(result.code).toBe(\"FILE_TOO_LARGE\");\n  });\n\n  it(\"accepts zero-byte audio file\", () => {\n    const f = makeFile(\"empty.mp3\", \"audio/mpeg\", 0);\n    expect(validateFile(f, \"audio\").ok).toBe(true);\n  });\n\n  it(\"rejects OGG audio\", () => {\n    const f = makeFile(\"song.ogg\", \"audio/ogg\", 2_000_000);\n    const result = validateFile(f, \"audio\");\n    expect(result.ok).toBe(false);\n    if (!result.ok) expect(result.code).toBe(\"INVALID_AUDIO_MIME_TYPE\");\n  });\n});","originalFile":"/**\n * Unit tests for the direct-to-storage upload hook and progress component.\n *\n * Covers:\n * - validateFile — valid audio, invalid size, invalid MIME type, image path\n * - useDirectUpload — idle state, state transitions, validation rejection\n * - FileUploadProgress — renders all state appearances correctly\n *\n * @module tests/unit/components/upload\n */\n\nimport { beforeEach, describe, expect, it, vi } from \"vitest\";\n\nimport { cleanup, render, screen } from \"@testing-library/react\";\nimport { afterEach } from \"node:test\";\n\nimport { FileUploadProgress } from \"@/components/FileUploadProgress\";\nimport { useDirectUpload, validateFile } from \"@/lib/hooks/useDirectUpload\";\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\n/** Create a mock File with given name, type, and size. */\nfunction makeFile(\n  name = \"test.mp3\",\n  type = \"audio/mpeg\",\n  size = 1_000_000,\n): File {\n  return new File([new ArrayBuffer(size)], name, { type });\n}\n\n// ---------------------------------------------------------------------------\n// beforeEach / afterEach\n// ---------------------------------------------------------------------------\n\nbeforeEach(() => {\n  vi.restoreAllMocks();\n});\n\nafterEach(() => {\n  vi.clearAllMocks();\n});\n\n// ---------------------------------------------------------------------------\n// validateFile — unit tests\n// ---------------------------------------------------------------------------\n\ndescribe(\"validateFile\", () => {\n  it(\"accepts a valid MP3 file\", () => {\n    const file = makeFile(\"song.mp3\", \"audio/mpeg\", 10_000_000);\n    const result = validateFile(file, \"audio\");\n    expect(result.ok).toBe(true);\n  });\n\n  it(\"accepts a valid WAV file\", () => {\n    const file = makeFile(\"track.wav\", \"audio/wav\", 5_000_000);\n    const result = validateFile(file, \"audio\");\n    expect(result.ok).toBe(true);\n  });\n\n  it(\"rejects an audio file that exceeds 50 MB\", () => {\n    const file = makeFile(\"huge.mp3\", \"audio/mpeg\", 51 * 1024 * 1024);\n    const result = validateFile(file, \"audio\");\n    expect(result.ok).toBe(false);\n    if (!result.ok) {\n      expect(result.code).toBe(\"FILE_TOO_LARGE\");\n    }\n  });\n\n  it(\"rejects an MP3 with invalid MIME type for audio\", () => {\n    const file = makeFile(\"bad.opus\", \"audio/opus\", 1_000_000);\n    const result = validateFile(file, \"audio\");\n    expect(result.ok).toBe(false);\n    if (!result.ok) {\n      expect(result.code).toBe(\"INVALID_AUDIO_MIME_TYPE\");\n    }\n  });\n\n  it(\"passes image files through without MIME validation\", () => {\n    const file = makeFile(\"photo.jpg\", \"image/jpeg\", 2_000_000);\n    const result = validateFile(file, \"image\");\n    expect(result.ok).toBe(true);\n  });\n\n  it(\"passes image files over 50 MB through (backend checks)\", () => {\n    const file = makeFile(\"big.png\", \"image/png\", 60 * 1024 * 1024);\n    const result = validateFile(file, \"image\");\n    expect(result.ok).toBe(true);\n  });\n\n  it(\"rejects a WAV file with MP3 MIME type\", () => {\n    const file = makeFile(\"fake.mp3\", \"audio/mpeg\", 100_000);\n    const result = validateFile(file, \"audio\");\n    expect(result.ok).toBe(true);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// useDirectUpload — unit tests (render hook pattern)\n// ---------------------------------------------------------------------------\n\ndescribe(\"useDirectUpload\", () => {\n  beforeEach(() => {\n    // Mock fetch globally so network calls don't happen\n    vi.resetModules();\n    vi.spyOn(global, \"fetch\").mockResolvedValue(\n      new Response(\n        JSON.stringify({\n          success: true,\n          data: { url: \"http://mock.presigned.url\", objectKey: \"audio/1/abc.mp3\" },\n        }),\n        { status: 200 },\n      ),\n    );\n  });\n\n  /**\n   * Render the hook via a tiny test wrapper component so we can inspect state.\n   */\n  function renderHook() {\n    let result: { state: ReturnType<typeof useDirectUpload>[\"state\"]; upload: ReturnType<typeof useDirectUpload>[\"upload\"] };\n\n    function TestWrapper() {\n      const hookResult = useDirectUpload({\n        onProgress: vi.fn(),\n        onComplete: vi.fn(),\n        onError: vi.fn(),\n      });\n      result = hookResult;\n      return <div />;\n    }\n\n    render(<TestWrapper />);\n    return result!;\n  }\n\n  it(\"starts in idle state\", () => {\n    const { state } = renderHook();\n    expect(state.status).toBe(\"idle\");\n  });\n\n  it(\"transitions to validating then requests presigned URL\", async () => {\n    const { state, upload } = renderHook();\n    const file = makeFile(\"demo.mp3\", \"audio/mpeg\", 5_000_000);\n\n    // Kick off the upload\n    void upload(file, \"artist-1\");\n\n    // Let validation and network fire\n    await new Promise((r) => setTimeout(r, 50));\n    expect(state.status).toBe(\"requesting\");\n\n    // Wait for the presigned URL to come back and PUT to be sent\n    await new Promise((r) => setTimeout(r, 100));\n    expect(state.status).toBe(\"completed\");\n  });\n\n  it(\"rejects oversized files with error state\", async () => {\n    // Reset fetch mock — we shouldn't reach the network\n    vi.spyOn(global, \"fetch\").mockReset();\n\n    const { state, upload } = renderHook();\n    const big = makeFile(\"huge.mp3\", \"audio/mpeg\", 51 * 1024 * 1024);\n\n    void upload(big, \"artist-1\");\n\n    // Validation should happen synchronously inside the microtask queue\n    await new Promise((r) => setTimeout(r, 50));\n    expect(state.status).toBe(\"error\");\n    if (state.status === \"error\") {\n      expect(state.code).toBe(\"FILE_TOO_LARGE\");\n    }\n    expect(global.fetch).not.toHaveBeenCalled();\n  });\n\n  it(\"bubbles upload intent errors into error state\", async () => {\n    vi.spyOn(global, \"fetch\").mockRejectedValue(new Error(\"ECONNREFUSED\"));\n    const { state, upload } = renderHook();\n    const file = makeFile(\"ok.mp3\", \"audio/mpeg\", 1_000_000);\n\n    void upload(file, \"artist-1\");\n\n    await new Promise((r) => setTimeout(r, 100));\n    expect(state.status).toBe(\"error\");\n    if (state.status === \"error\") {\n      expect(state.code).toBe(\"NETWORK_ERROR\");\n    }\n  });\n\n  it(\"completes with the returned URL and objectKey\", async () => {\n    const onComplete = vi.fn();\n    let result: { state: ReturnType<typeof useDirectUpload>[\"state\"]; upload: ReturnType<typeof useDirectUpload>[\"upload\"] } | null = null;\n\n    function TestWrapper() {\n      result = useDirectUpload({ onComplete });\n      return <div />;\n    }\n\n    render(<TestWrapper />);\n\n    if (!result) throw new Error(\"test wrapper failed\");\n\n    const file = makeFile(\"demo.mp3\", \"audio/mpeg\", 1_000_000);\n    void result.upload(file, \"artist-1\");\n\n    await new Promise((r) => setTimeout(r, 100));\n\n    expect(result.state.status).toBe(\"completed\");\n    if (result.state.status === \"completed\") {\n      expect(result.state.url).toBe(\"http://mock.presigned.url\");\n      expect(result.state.objectKey).toContain(\"audio\");\n    }\n    expect(onComplete).toHaveBeenCalledWith(\n      expect.objectContaining({ url: \"http://mock.presigned.url\" }),\n    );\n  });\n});\n\n// ---------------------------------------------------------------------------\n// FileUploadProgress — component tests\n// ---------------------------------------------------------------------------\n\ndescribe(\"FileUploadProgress\", () => {\n  afterEach(cleanup);\n\n  it(\"renders idle state\", () => {\n    render(<FileUploadProgress state={{ status: \"idle\" }} />);\n    expect(screen.getByRole(\"progressbar\")).toBeDefined();\n    // Progress bar should be at 0% in idle\n    const progressBar = screen.getByRole(\"progressbar\");\n    expect(progressBar).toHaveAttribute(\"aria-valuemin\", \"0\");\n    expect(progressBar).toHaveAttribute(\"aria-valuemax\", \"100\");\n  });\n\n  it(\"renders percentage in uploading state\", async () => {\n    render(<FileUploadProgress state={{ status: \"uploading\", progress: 65, objectKey: \"x\" }} />);\n    expect(screen.getByText(\"65%\")).toBeDefined();\n  });\n\n  it(\"renders completed state\", () => {\n    render(<FileUploadProgress state={{ status: \"completed\", url: \"http://x\", objectKey: \"y\" }} />);\n    expect(screen.getByText(\"Upload complete\")).toBeDefined();\n    expect(screen.getByText(\"File uploaded successfully.\")).toBeDefined();\n  });\n\n  it(\"renders error with alert role and message\", () => {\n    render(\n      <FileUploadProgress\n        state={{ status: \"error\", message: \"Upload failed\", code: \"UPLOAD_FAILED\" }}\n      />\n    );\n    expect(screen.getByText(\"Upload failed\")).toBeDefined();\n    expect(screen.getByRole(\"alert\")).toHaveTextContent(\"Upload failed\");\n  });\n\n  it(\"exposes aria-valuenow during upload\", () => {\n    render(<FileUploadProgress state={{ status: \"uploading\", progress: 40, objectKey: \"k\" }} />);\n    const bar = screen.getByRole(\"progressbar\");\n    expect(bar).toHaveAttribute(\"aria-valuenow\", \"40\");\n    expect(bar).toHaveAttribute(\"aria-valuetext\", \"40%\");\n  });\n});\n","structuredPatch":[{"oldStart":260,"oldLines":4,"newStart":260,"newLines":65,"lines":["     expect(bar).toHaveAttribute(\"aria-valuenow\", \"40\");","     expect(bar).toHaveAttribute(\"aria-valuetext\", \"40%\");","   });","+","+  it(\"requires aria-live polite region for screen readers\", () => {","+    render(<FileUploadProgress state={{ status: \"uploading\", progress: 30, objectKey: \"\" }} />);","+    const live = document.querySelector(\"[aria-live='polite']\");","+    expect(live).toBeInTheDocument();","+  });","+","+  it(\"applies custom className to wrapper div\", () => {","+    const { container } = render(","+      <FileUploadProgress state={{ status: \"idle\" }} className=\"custom-panel\" />,","+    );","+    expect(container.firstChild).toHaveClass(\"custom-panel\");","+  });","+","+  it(\"progress bar wrapper uses fluid width for responsiveness\", () => {","+    const { container } = render(","+      <FileUploadProgress state={{ status: \"uploading\", progress: 20, objectKey: \"\" }} />,","+    );","+    const bar = container.querySelector<any>(\"[role='progressbar']\");","+    expect(bar).toHaveClass(\"w-full\");","+  });","+","+  it(\"outer wrapper stacks children vertically\", () => {","+    const { container } = render(<FileUploadProgress state={{ status: \"idle\" }} />);","+    expect(container.firstChild).toHaveClass(\"flex-col\");","+  });","+","+  it(\"displays zero percent for uploading at start\", () => {","+    render(<FileUploadProgress state={{ status: \"uploading\", progress: 0, objectKey: \"\" }} />);","+    expect(screen.getByText(\"0%\")).toBeInTheDocument();","+  });"," });","+","+// ---------------------------------------------------------------------------","+// validateFile — additional edge cases","+// ---------------------------------------------------------------------------","+","+describe(\"validateFile — edge cases\", () => {","+  it(\"accepts exactly 50 MB\", () => {","+    const f = makeFile(\"exact.mp3\", \"audio/mpeg\", 50 * 1024 * 1024);","+    expect(validateFile(f, \"audio\").ok).toBe(true);","+  });","+","+  it(\"rejects 50 MB + 1 byte\", () => {","+    const f = makeFile(\"overflow.mp3\", \"audio/mpeg\", 50 * 1024 * 1024 + 1);","+    const result = validateFile(f, \"audio\");","+    expect(result.ok).toBe(false);","+    if (!result.ok) expect(result.code).toBe(\"FILE_TOO_LARGE\");","+  });","+","+  it(\"accepts zero-byte audio file\", () => {","+    const f = makeFile(\"empty.mp3\", \"audio/mpeg\", 0);","+    expect(validateFile(f, \"audio\").ok).toBe(true);","+  });","+","+  it(\"rejects OGG audio\", () => {","+    const f = makeFile(\"song.ogg\", \"audio/ogg\", 2_000_000);","+    const result = validateFile(f, \"audio\");","+    expect(result.ok).toBe(false);","+    if (!result.ok) expect(result.code).toBe(\"INVALID_AUDIO_MIME_TYPE\");","+  });","+});"]}],"userModified":false,"replaceAll":false}}
