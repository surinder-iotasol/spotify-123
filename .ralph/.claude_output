s arrive. */\n53\t  onProgress?: (percent: number) => void;\n54\t  /** Called when the upload completes with the result data. */\n55\t  onComplete?: (result: { url: string; objectKey: string }) => void;\n56\t  /** Called when validation, the upload-intent request, or the PUT fails. */\n57\t  onError?: (message: string, code: string) => void;\n58\t}\n59\t\n60\t/**\n61\t * Narrow auto-cast an UploadState that is known to carry `message`/`code`.\n62\t */\n63\ttype ErrorState = Extract<UploadState, { status: \"error\" }>;\n64\t\n65\t// ---------------------------------------------------------------------------\n66\t// Validation\n67\t// ---------------------------------------------------------------------------\n68\t\n69\t/**\n70\t * Validate a file against upload rules at the client.\n71\t *\n72\t * Audio files are checked against the MIME-type allowlist and the 50 MB cap.\n73\t * Image files are passed through (the backend enforces image limits).\n74\t *\n75\t * @param file — The file to check.\n76\t * @param fileType — `\"audio\"` or `\"image\"`.\n77\t * @returns A `ValidateResult`; `ok` is `false` when validation fails.\n78\t */\n79\texport function validateFile(\n80\t  file: File,\n81\t  fileType: \"audio\" | \"image\",\n82\t): ValidateResult {\n83\t  if (fileType === \"audio\") {\n84\t    if (!ALLOWED_AUDIO_TYPES.includes(file.type)) {\n85\t      return {\n86\t        ok: false,\n87\t        code: \"INVALID_AUDIO_MIME_TYPE\",\n88\t        message: `Audio uploads must be one of: ${ALLOWED_AUDIO_TYPES.join(\", \")}`,\n89\t      };\n90\t    }\n91\t    if (file.size > MAX_AUDIO_SIZE) {\n92\t      return {\n93\t        ok: false,\n94\t        code: \"FILE_TOO_LARGE\",\n95\t        message: `Audio files must not exceed ${MAX_AUDIO_SIZE / (1024 * 1024)} MB`,\n96\t      };\n97\t    }\n98\t  }\n99\t  return { ok: true };\n100\t}\n101\t\n102\t// ---------------------------------------------------------------------------\n103\t// Hook\n104\t// ---------------------------------------------------------------------------\n105\t\n106\t/**\n107\t * React hook for direct-to-storage file uploads.\n108\t *\n109\t * Orchestrates three steps:\n110\t * 1. Pre-upload validation via {@link validateFile}.\n111\t * 2. A POST to the upload-intent endpoint to obtain a presigned URL.\n112\t * 3. A direct PUT binary transfer to S3/R2.\n113\t *\n114\t * The returned `state` object is **mutated in-place** while the same\n115\t * reference is returned on every render, so that callers holding a single\n116\t * reference to `{ state, upload }` see live status updates.\n117\t *\n118\t * @example\n119\t * ```tsx\n120\t * const { state, upload } = useDirectUpload();\n121\t * const handleFile = (file: File) => upload(file, \"artist-1\");\n122\t * ```\n123\t */\n124\texport function useDirectUpload(\n125\t  opts: UseDirectUploadOptions = {},\n126\t): {\n127\t  state: UploadState;\n128\t  upload: (file: File, artistId: string) => Promise<void>;\n129\t} {\n130\t  const { onProgress, onComplete, onError } = opts;\n131\t\n132\t  // Use an internal mutable wrapper so the reference returned to callers\n133\t  // never changes, which avoids unnecessary re-renders for consumers that\n134\t  // hold `state` in a cell without rerendering.\n135\t  const internal = { current: { status: \"idle\" as UploadState[\"status\"] } };\n136\t  const state = internal.current as UploadState;\n137\t\n138\t  const upload = async (file: File, artistId: string): Promise<void> => {\n139\t    // v0: client-side validation\n140\t    const validation = validateFile(file, \"audio\");\n141\t\n142\t    if (!validation.ok) {\n143\t      const msg = validation.message ?? \"Validation failed\";\n144\t      const code = validation.code ?? \"VALIDATION_ERROR\";\n145\t      Object.assign(state, { status: \"error\" as const, message: msg, code });\n146\t      onError?.(msg, code);\n147\t      return;\n148\t    }\n149\t\n150\t    // v1: requesting presigned URL\n151\t    Object.assign(state, { status: \"requesting\" as const });\n152\t\n153\t    try {\n154\t      const resp = await fetch(DEFAULT_API_PATH, {\n155\t        method: \"POST\",\n156\t        headers: { \"Content-Type\": \"application/json\" },\n157\t        body: JSON.stringify({\n158\t          fileType: \"audio\",\n159\t          fileName: file.name,\n160\t          fileSizeBytes: file.size,\n161\t          mimeType: file.type,\n162\t          artistId,\n163\t        }),\n164\t      });\n165\t\n166\t      if (!resp.ok) {\n167\t        const msg = `Upload request failed (HTTP ${resp.status})`;\n168\t        Object.assign(state, { status: \"error\" as const, message: msg, code: \"NETWORK_ERROR\" });\n169\t        onError?.(msg, \"NETWORK_ERROR\");\n170\t        return;\n171\t      }\n172\t\n173\t      const data = await resp.json();\n174\t      const url = data.data?.url ?? data.url;\n175\t      const objectKey = data.data?.objectKey ?? data.objectKey;\n176\t\n177\t      if (!url) {\n178\t        const msg = \"No upload URL received from server\";\n179\t        Object.assign(state, { status: \"error\" as const, message: msg, code: \"NO_UPLOAD_URL\" });\n180\t        onError?.(msg, \"NO_UPLOAD_URL\");\n181\t        return;\n182\t      }\n183\t\n184\t      // v2: direct PUT\n185\t      Object.assign(state, { status: \"uploading\" as const, progress: 0 });\n186\t      onProgress?.(0);\n187\t\n188\t      const putResp = await fetch(url, {\n189\t        method: \"PUT\",\n190\t        body: file,\n191\t        headers: { \"Content-Type\": file.type },\n192\t      });\n193\t\n194\t      if (!putResp.ok) {\n195\t        const msg = `Upload failed (HTTP ${putResp.status})`;\n196\t        Object.assign(state, { status: \"error\" as const, message: msg, code: \"UPLOAD_FAILED\" });\n197\t        onError?.(msg, \"UPLOAD_FAILED\");\n198\t        return;\n199\t      }\n200\t\n201\t      // v3: completed\n202\t      Object.assign(state, { status: \"completed\" as const, url, objectKey: objectKey ?? \"\" });\n203\t      onProgress?.(100);\n204\t      onComplete?.({ url, objectKey: objectKey ?? \"\" });\n205\t    } catch (err: unknown) {\n206\t      const msg = err instanceof Error ? err.message : \"Network error\";\n207\t      Object.assign(state, { status: \"error\" as const, message: msg, code: \"NETWORK_ERROR\" });\n208\t      onError?.(msg, \"NETWORK_ERROR\");\n209\t    }\n210\t  };\n211\t\n212\t  return { upload: upload as (file: File, artistId: string) => Promise<void>, state };\n213\t}\n214\t"}]},"parent_tool_use_id":null,"session_id":"d72108ba-fafb-4f6f-9e75-414ab1f88a10","uuid":"3ed31b8b-d036-4ff5-be6c-d2c1c5912b2c","timestamp":"2026-08-06T06:49:33.830Z","tool_use_result":{"type":"text","file":{"filePath":"/home/nitin-sharma/ralph-workspaces/e29dbeb9-bd50-43bd-b208-68007e42ec25/1f096f0a-73e7-4dbb-b1e9-ac762bb210e5/src/lib/hooks/useDirectUpload.ts","content":"/**\n * Direct-to-storage upload hook and file validators.\n *\n * Manages the full upload lifecycle: pre-upload validation (file size + MIME\n * type), requesting a presigned PUT URL from the upload-intent endpoint, and\n * executing the binary transfer to S3/R2 with progress tracking.\n *\n * @module lib/hooks/useDirectUpload\n */\n\n// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\n\n/** Maximum audio file size: 50 MB (52,428,800 bytes). */\nconst MAX_AUDIO_SIZE = 52_428_800;\n\n/** Allowed audio MIME types. */\nconst ALLOWED_AUDIO_TYPES = [\"audio/mpeg\", \"audio/wav\"];\n\n/** Default upload-intent API path. */\nconst DEFAULT_API_PATH = \"/api/v1/storage/upload-intent\";\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/**\n * Validation result for a client-side file check.\n */\nexport interface ValidateResult {\n  ok: boolean;\n  code?: string;\n  message?: string;\n}\n\n/**\n * Possible states for the upload hook.\n */\nexport type UploadState =\n  | { status: \"idle\" }\n  | { status: \"validating\"; file: File }\n  | { status: \"requesting\" }\n  | { status: \"uploading\"; progress: number }\n  | { status: \"completed\"; url: string; objectKey: string }\n  | { status: \"error\"; message: string; code: string };\n\n/**\n * Callbacks passed into {@link useDirectUpload}.\n */\nexport interface UseDirectUploadOptions {\n  /** Called with the progress percentage (0–100) as valid HTTP responses arrive. */\n  onProgress?: (percent: number) => void;\n  /** Called when the upload completes with the result data. */\n  onComplete?: (result: { url: string; objectKey: string }) => void;\n  /** Called when validation, the upload-intent request, or the PUT fails. */\n  onError?: (message: string, code: string) => void;\n}\n\n/**\n * Narrow auto-cast an UploadState that is known to carry `message`/`code`.\n */\ntype ErrorState = Extract<UploadState, { status: \"error\" }>;\n\n// ---------------------------------------------------------------------------\n// Validation\n// ---------------------------------------------------------------------------\n\n/**\n * Validate a file against upload rules at the client.\n *\n * Audio files are checked against the MIME-type allowlist and the 50 MB cap.\n * Image files are passed through (the backend enforces image limits).\n *\n * @param file — The file to check.\n * @param fileType — `\"audio\"` or `\"image\"`.\n * @returns A `ValidateResult`; `ok` is `false` when validation fails.\n */\nexport function validateFile(\n  file: File,\n  fileType: \"audio\" | \"image\",\n): ValidateResult {\n  if (fileType === \"audio\") {\n    if (!ALLOWED_AUDIO_TYPES.includes(file.type)) {\n      return {\n        ok: false,\n        code: \"INVALID_AUDIO_MIME_TYPE\",\n        message: `Audio uploads must be one of: ${ALLOWED_AUDIO_TYPES.join(\", \")}`,\n      };\n    }\n    if (file.size > MAX_AUDIO_SIZE) {\n      return {\n        ok: false,\n        code: \"FILE_TOO_LARGE\",\n        message: `Audio files must not exceed ${MAX_AUDIO_SIZE / (1024 * 1024)} MB`,\n      };\n    }\n  }\n  return { ok: true };\n}\n\n// ---------------------------------------------------------------------------\n// Hook\n// ---------------------------------------------------------------------------\n\n/**\n * React hook for direct-to-storage file uploads.\n *\n * Orchestrates three steps:\n * 1. Pre-upload validation via {@link validateFile}.\n * 2. A POST to the upload-intent endpoint to obtain a presigned URL.\n * 3. A direct PUT binary transfer to S3/R2.\n *\n * The returned `state` object is **mutated in-place** while the same\n * reference is returned on every render, so that callers holding a single\n * reference to `{ state, upload }` see live status updates.\n *\n * @example\n * ```tsx\n * const { state, upload } = useDirectUpload();\n * const handleFile = (file: File) => upload(file, \"artist-1\");\n * ```\n */\nexport function useDirectUpload(\n  opts: UseDirectUploadOptions = {},\n): {\n  state: UploadState;\n  upload: (file: File, artistId: string) => Promise<void>;\n} {\n  const { onProgress, onComplete, onError } = opts;\n\n  // Use an internal mutable wrapper so the reference returned to callers\n  // never changes, which avoids unnecessary re-renders for consumers that\n  // hold `state` in a cell without rerendering.\n  const internal = { current: { status: \"idle\" as UploadState[\"status\"] } };\n  const state = internal.current as UploadState;\n\n  const upload = async (file: File, artistId: string): Promise<void> => {\n    // v0: client-side validation\n    const validation = validateFile(file, \"audio\");\n\n    if (!validation.ok) {\n      const msg = validation.message ?? \"Validation failed\";\n      const code = validation.code ?? \"VALIDATION_ERROR\";\n      Object.assign(state, { status: \"error\" as const, message: msg, code });\n      onError?.(msg, code);\n      return;\n    }\n\n    // v1: requesting presigned URL\n    Object.assign(state, { status: \"requesting\" as const });\n\n    try {\n      const resp = await fetch(DEFAULT_API_PATH, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          fileType: \"audio\",\n          fileName: file.name,\n          fileSizeBytes: file.size,\n          mimeType: file.type,\n          artistId,\n        }),\n      });\n\n      if (!resp.ok) {\n        const msg = `Upload request failed (HTTP ${resp.status})`;\n        Object.assign(state, { status: \"error\" as const, message: msg, code: \"NETWORK_ERROR\" });\n        onError?.(msg, \"NETWORK_ERROR\");\n        return;\n      }\n\n      const data = await resp.json();\n      const url = data.data?.url ?? data.url;\n      const objectKey = data.data?.objectKey ?? data.objectKey;\n\n      if (!url) {\n        const msg = \"No upload URL received from server\";\n        Object.assign(state, { status: \"error\" as const, message: msg, code: \"NO_UPLOAD_URL\" });\n        onError?.(msg, \"NO_UPLOAD_URL\");\n        return;\n      }\n\n      // v2: direct PUT\n      Object.assign(state, { status: \"uploading\" as const, progress: 0 });\n      onProgress?.(0);\n\n      const putResp = await fetch(url, {\n        method: \"PUT\",\n        body: file,\n        headers: { \"Content-Type\": file.type },\n      });\n\n      if (!putResp.ok) {\n        const msg = `Upload failed (HTTP ${putResp.status})`;\n        Object.assign(state, { status: \"error\" as const, message: msg, code: \"UPLOAD_FAILED\" });\n        onError?.(msg, \"UPLOAD_FAILED\");\n        return;\n      }\n\n      // v3: completed\n      Object.assign(state, { status: \"completed\" as const, url, objectKey: objectKey ?? \"\" });\n      onProgress?.(100);\n      onComplete?.({ url, objectKey: objectKey ?? \"\" });\n    } catch (err: unknown) {\n      const msg = err instanceof Error ? err.message : \"Network error\";\n      Object.assign(state, { status: \"error\" as const, message: msg, code: \"NETWORK_ERROR\" });\n      onError?.(msg, \"NETWORK_ERROR\");\n    }\n  };\n\n  return { upload: upload as (file: File, artistId: string) => Promise<void>, state };\n}\n","numLines":214,"startLine":1,"totalLines":214}}}
