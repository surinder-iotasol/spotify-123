l({ ok: true });\n  });\n\n  // --- Audio: size too large ---\n\n  it(\"rejects audio exceeding 50 MB\", () => {\n    const file = makeFile(\"big.mp3\", 55 * 1024 * 1024, \"audio/mpeg\");\n    const result = validateFile(file, \"audio\");\n    expect(result).toEqual({\n      ok: false,\n      code: \"FILE_TOO_LARGE\",\n      message: expect.stringContaining(\"50 MB\"),\n    });\n  });\n\n  // --- Audio: wrong MIME ---\n\n  it(\"rejects audio with disallowed MIME type\", () => {\n    const file = makeFile(\"song.flac\", 4_000_000, \"audio/flac\");\n    const result = validateFile(file, \"audio\");\n    expect(result).toEqual({\n      ok: false,\n      code: \"INVALID_AUDIO_MIME_TYPE\",\n      message: expect.stringContaining(\"audio/mpeg\"),\n    });\n  });\n\n  // --- Image: pass-through ---\n\n  it(\"accepts image regardless of size (backend enforces limit)\", () => {\n    const file = makeFile(\"photo.jpg\", 20 * 1024 * 1024, \"image/jpeg\");\n    const result = validateFile(file, \"image\");\n    expect(result).toEqual({ ok: true });\n  });\n\n  // --- Edge: zero-size file ---\n\n  it(\"accepts zero-byte file\", () => {\n    const file = makeFile(\"empty.mp3\", 0, \"audio/mpeg\");\n    const result = validateFile(file, \"audio\");\n    expect(result).toEqual({ ok: true });\n  });\n\n  // --- Edge: exact max size ---\n\n  it(\"accepts audio exactly at 50 MB limit\", () => {\n    const file = makeFile(\"max.mp3\", 50 * 1024 * 1024, \"audio/mpeg\");\n    const result = validateFile(file, \"audio\");\n    expect(result).toEqual({ ok: true });\n  });\n});\n\n// ---------------------------------------------------------------------------\n// useDirectUpload hook — state transitions\n// ---------------------------------------------------------------------------\n\ndescribe(\"useDirectUpload\", () => {\n  beforeEach(() => {\n    vi.restoreAllMocks();\n    vi.clearAllMocks();\n    // Mock fetch globally\n    vi.spyOn(globalThis, \"fetch\").mockResolvedValue({\n      ok: true,\n      status: 200,\n      json: async () => ({\n        success: true,\n        data: { url: \"https://mock.s3/upload-url\", objectKey: \"audio/artist-1/track-1.mp3\" },\n      }),\n      headers: new Headers(),\n    } as Response);\n    // Mock crypto.randomUUID\n    vi.spyOn(globalThis.crypto, \"randomUUID\").mockReturnValue(\"mock-uuid-123\");\n  });\n\n  it(\"starts in idle state\", () => {\n    const { wrapper } = renderHook();\n    const { result } = wrapper(() => useDirectUpload());\n    expect(result.current.state.status).toBe(\"idle\");\n  });\n\n  it(\"transitions to error on validation rejection\", async () => {\n    const bigFile = new File([\"x\".repeat(55 * 1024 * 1024)], \"big.mp3\", {\n      type: \"audio/mpeg\",\n      lastModified: Date.now(),\n    });\n    const { wrapper } = renderHook();\n    const { result, waitForState } = wrapper(() => {\n      const { state, upload } = useDirectUpload();\n      return { state, upload };\n    });\n    const { upload } = result.current;\n    upload(bigFile, \"artist-1\");\n    await waitForState((s) => s.state.status === \"error\");\n    expect(result.current.state.status).toBe(\"error\");\n    expect(result.current.state.code).toBe(\"FILE_TOO_LARGE\");\n  });\n\n  it(\"transitions through states on successful upload\", async () => {\n    const mockFetch = vi.fn();\n    mockFetch.mockImplementation((url: string, init: RequestInit) => {\n      if (url.includes(\"/api/v1/storage/upload-intent\") || url.includes(\"upload-intent\")) {\n        // Presigned URL request\n        return Promise.resolve({\n          ok: true,\n          status: 200,\n          json: async () => ({\n            success: true,\n            data: { url: \"https://mock-s3.example.com/upload\", objectKey: \"audio/a1/t1.mp3\" },\n          }),\n          headers: new Headers(),\n        } as Response);\n      }\n      // Direct PUT to S3\n      return Promise.resolve({\n        ok: true,\n        status: 200,\n        headers: new Headers(),\n      } as Response);\n    });\n    vi.spyOn(globalThis, \"fetch\").mockImplementation(mockFetch);\n\n    const { wrapper } = renderHook();\n    const { result, waitForState } = wrapper(() => {\n      const { state, upload } = useDirectUpload();\n      return { state, upload };\n    });\n\n    const file = new File([\"data\"], \"song.mp3\", { type: \"audio/mpeg\", lastModified: Date.now() });\n    result.current.upload(file, \"artist-1\");\n\n    // Should reach requesting state\n    await waitForState((s) => s.state.status === \"requesting\" || s.state.status === \"uploading\");\n    // Should eventually complete\n    await waitForState((s) => s.state.status === \"completed\");\n    expect(result.current.state.status).toBe(\"completed\");\n  });\n});\n\n// ---------------------------------------------------------------------------\n// FileUploadProgress component rendering\n// ---------------------------------------------------------------------------\n\ndescribe(\"FileUploadProgress\", () => {\n  /** Fixture for each state */\n  function renderProgress(state: UploadState) {\n    return render(<FileUploadProgress state={state} />);\n  }\n\n  it(\"renders progress bar in idle state\", () => {\n    renderProgress({ status: \"idle\" });\n    expect(screen.getByRole(\"progressbar\")).toBeInTheDocument();\n    expect(screen.getByText(\"--\")).toBeInTheDocument();\n  });\n\n  it(\"displays uploading percentage\", () => {\n    renderProgress({ status: \"uploading\", progress: 72, objectKey: \"audio/test\" });\n    expect(screen.getByText(\"72%\")).toHaveClass(\"tabular-nums\");\n  });\n\n  it(\"shows completed status\", () => {\n    renderProgress({ status: \"completed\", url: \"https://s3/test\", objectKey: \"audio/test\" });\n    expect(screen.getByText(\"Upload complete\")).toBeInTheDocument();\n    expect(screen.getByRole(\"status\")).toHaveClass(\"bg-green-500/10\");\n  });\n\n  it(\"renders error with alert role\", () => {\n    renderProgress({ status: \"error\", message: \"Network error\", code: \"UPLOAD_FAILED\" });\n    expect(screen.getByRole(\"alert\")).toHaveTextContent(\"Network error\");\n  });\n\n  it(\"applies custom className\", () => {\n    const { container } = render(\n      <FileUploadProgress state={{ status: \"idle\" }} className=\"my-custom-class\" />,\n    );\n    expect(container.firstChild).toHaveClass(\"my-custom-class\");\n  });\n\n  it(\"supports custom label\", () => {\n    render(\n      <FileUploadProgress\n        state={{ status: \"uploading\", progress: 50, objectKey: \"\" }}\n        label=\"My custom label\"\n      />,\n    );\n    const bar = screen.getByRole(\"progressbar\");\n    expect(bar).toHaveAttribute(\"aria-valuetext\", \"50%\");\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Accessibility\n// ---------------------------------------------------------------------------\n\ndescribe(\"FileUploadProgress — accessibility\", () => {\n  it(\"progress bar has role progressbar with min/max\", () => {\n    renderProgress({ status: \"uploading\", progress: 60, objectKey: \"\" });\n    const bar = screen.getByRole(\"progressbar\");\n    expect(bar).toHaveAttribute(\"aria-valuemin\", \"0\");\n    expect(bar).toHaveAttribute(\"aria-valuemax\", \"100\");\n  });\n\n  it(\"level region announces state\", () => {\n    renderProgress({ status: \"completed\", url: \"\", objectKey: \"\" });\n    // The sr-only live region contains the state label\n    const live = document.querySelector(\"[aria-live='polite']\");\n    expect(live).toBeInTheDocument();\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Responsive (CSS class checks — behavioural only)\n// ---------------------------------------------------------------------------\n\ndescribe(\"FileUploadProgress — responsive behaviour\", () => {\n  it(\"wrapper uses flex-col for vertical stacking\", () => {\n    const { container } = renderProgress({ status: \"idle\" });\n    expect(container.firstChild).toHaveClass(\"flex-col\");\n  });\n\n  it(\"progress bar uses w-full (fluid width)\", () => {\n    const { container } = renderProgress({ status: \"uploading\", progress: 30, objectKey: \"\" });\n    const bar = container.querySelector(\"[role='progressbar']\");\n    expect(bar).toHaveClass(\"w-full\");\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Hook helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Lightweight wrapper to render hooks in vitest/jsdom context.\n */\nfunction renderHook<T>(render: () => T) {\n  let value: T | undefined;\n  let renderCount = 0;\n\n  function Helper(): T {\n    renderCount++;\n    value = render();\n    return value as T;\n  }\n\n  // @ts-expect-error — we mock the React renderer minimally\n  const { rerender } = render(\n    <Helper />,\n    { container: document.createElement(\"div\") },\n  );\n\n  function waitForState(check: (state: T) => boolean, timeout = 2000) {\n    return new Promise<void>((resolve, reject) => {\n      const start = Date.now();\n      function tick() {\n        rerender(<Helper />);\n        if (check(value as T)) {\n          resolve();\n          return;\n        }\n        if (Date.now() - start > timeout) {\n          reject(new Error(\"Timeout waiting for state\"));\n          return;\n        }\n        setTimeout(tick, 50);\n      }\n      tick();\n    });\n  }\n\n  return {\n    wrapper: { rerender },\n    result: { current: value },\n    waitForState,\n  };\n}\n"}}],"model":"qwen3.6-35b","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":111869,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"d72108ba-fafb-4f6f-9e75-414ab1f88a10","uuid":"1594b6a0-b68d-4d17-8c1d-a504ac3cd380","timestamp":"2026-08-06T05:16:25.790Z"}
