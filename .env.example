# Database
# MongoDB connection string. Must point to a running MongoDB instance.
DATABASE_URL="mongodb://localhost:27017/ralph-dev"

# JWT
# Opaque secret used to sign and verify session tokens. Change in production.
JWT_SECRET="change-me-to-a-random-256-bit-string"

# AWS / S3-compatible storage
AWS_REGION="us-east-1"

# AWS access key identifier for S3 or R2.
AWS_ACCESS_KEY_ID="your-access-key-id"

# AWS secret access key for S3 or R2.
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Name of the S3/R2 bucket used for asset storage.
S3_BUCKET_NAME="ralph-storage"

# S3-compatible endpoint URL (e.g. Minio, Cloudflare R2, or AWS S3).
S3_ENDPOINT="http://localhost:9000"
